# Postgres — on Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/outset_pm"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
# Public URL of the app (Railway domain in production)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Google OAuth client (optional: leave empty to use passwords only) (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# The same OAuth client is used for "Connect Google" (Calendar + Gmail).
# Add both redirect URIs in Google Cloud:
#   <AUTH_URL>/api/auth/callback/google   (sign-in)
#   <AUTH_URL>/api/google/callback         (Calendar + Gmail)
# Only Google Workspace accounts on this domain may sign in
ALLOWED_EMAIL_DOMAIN="outsetadvisory.com"

# Seed: the first Director account
BOOTSTRAP_DIRECTOR_EMAIL="tinashe@outsetadvisory.com"
# First password for that Director (min 10 characters). Only used if they have none yet;
# change it afterwards under My account. Other staff get passwords from Settings → Team.
BOOTSTRAP_DIRECTOR_PASSWORD=""
BOOTSTRAP_DIRECTOR_NAME="Tinashe Zano"

# Local development only: show an email-only sign-in for seeded users.
# Ignored when NODE_ENV=production.
DEV_LOGIN_ENABLED=false

# Background automations run inside the web server. Set to false only if you
# run the worker as a separate process.
WORKER_ENABLED=true

# Paystack (Settings → API Keys & Webhooks in your Paystack dashboard).
# sk_test_… = test mode (test cards, no real money); sk_live_… = live.
# Leave empty on a development machine to use the simulated checkout.
PAYSTACK_SECRET_KEY=""

# Postgres — on Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/outset_pm"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
# Public URL of the app (Railway domain in production)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Only Google Workspace accounts on this domain may sign in
ALLOWED_EMAIL_DOMAIN="outsetadvisory.com"

# Seed: the first Director account
BOOTSTRAP_DIRECTOR_EMAIL="tinashe@outsetadvisory.com"
BOOTSTRAP_DIRECTOR_NAME="Tinashe Zano"

# Local development only: show an email-only sign-in for seeded users.
# Ignored when NODE_ENV=production.
DEV_LOGIN_ENABLED=false

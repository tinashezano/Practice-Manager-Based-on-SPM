{
  "name": "outset-pm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:railway": "prisma migrate deploy && prisma db seed && next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",

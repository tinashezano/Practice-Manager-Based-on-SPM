generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DIRECTOR
  ACCOUNTANT
  BOOKKEEPER
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  role                Role      @default(BOOKKEEPER)
  active              Boolean   @default(true)
  image               String?
  weeklyCapacityHours Int       @default(40)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  ownedClients   Client[]          @relation("ClientOwner")
  ownedProjects  Project[]         @relation("ProjectOwner")
  assignedTasks  Task[]            @relation("TaskAssignee")
  reviewTasks    Task[]            @relation("TaskReviewer")
  createdTasks   Task[]            @relation("TaskCreator")
  comments       TaskComment[]
  notifications  Notification[]
  ownedDeals     Deal[]            @relation("DealOwner")
  ownedResources Resource[]        @relation("ResourceOwner")
  resourceReads  ResourceRead[]
  enrollments    Enrollment[]      @relation("Enrollee")
  mentoring      Enrollment[]      @relation("Mentor")
  bookingLinks   BookingLink[]
  bookings       Booking[]
  google         GoogleConnection?
}

// Every automation-relevant thing that happens is recorded here first, then
// handled by background jobs. Also serves as the audit trail and the place we
// de-duplicate retried webhooks (via idempotencyKey).
model EventLog {
  id             String    @id @default(cuid())
  type           String
  payload        Json
  idempotencyKey String?   @unique
  actorId        String?
  processedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  @@index([type, createdAt])
  @@index([processedAt])
}

enum EntityType {
  PRIVATE_COMPANY
  SOLE_PROPRIETOR
  INDIVIDUAL
  TRUST
  PARTNERSHIP
  NPO
  OTHER
}

enum ClientStatus {
  ONBOARDING
  ACTIVE
  INACTIVE
}

model Client {
  id                 String       @id @default(cuid())
  name               String
  entityType         EntityType   @default(PRIVATE_COMPANY)
  status             ClientStatus @default(ACTIVE)
  // The firm's own admin work lives under one internal "client" so every task
  // still sits under a client.
  isInternal         Boolean      @default(false)
  registrationNumber String?
  taxNumber          String?
  vatNumber          String?
  email              String?
  phone              String?
  address            String?
  notes              String?
  ownerId            String?
  owner              User?        @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  contacts      ClientContact[]
  projects      Project[]
  tasks         Task[]
  deals         Deal[]
  proposals     Proposal[]
  subscriptions Subscription[]
  onboardings   Onboarding[]

  @@index([status])
}

model ClientContact {
  id        String  @id @default(cuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  position  String?
  isPrimary Boolean @default(false)
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

model Project {
  id          String           @id @default(cuid())
  clientId    String
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      ProjectStatus    @default(ACTIVE)
  ownerId     String?
  owner       User?            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  startDate   DateTime?        @db.Date
  dueDate     DateTime?        @db.Date
  templateId  String?
  template    ProjectTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tasks Task[]

  @@index([clientId])
}

enum Recurrence {
  NONE
  WEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  ANNUALLY
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING_ON_CLIENT
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id              String     @id @default(cuid())
  title           String
  description     String?
  status          TaskStatus @default(TODO)
  priority        Priority   @default(MEDIUM)
  // Every task belongs to a client — or, before they become one, to a lead
  // (deal). Project is optional; parentId makes it a subtask.
  clientId        String?
  client          Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dealId          String?
  deal            Deal?      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  // Set on tasks created by an automation (e.g. "deal.discovery_call") so
  // completing them can trigger the next step.
  automationKey   String?
  recurrence      Recurrence @default(NONE)
  projectId       String?
  project         Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentId        String?
  parent          Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks        Task[]     @relation("Subtasks")
  assigneeId      String?
  assignee        User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewerId      String?
  reviewer        User?      @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  startDate       DateTime?  @db.Date
  dueDate         DateTime?  @db.Date
  estimateMinutes Int?
  position        Float      @default(0)
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  comments       TaskComment[]
  attachments    TaskAttachment[]
  // The SOP for this task (from its job template, or linked by hand).
  resourceId     String?
  resource       Resource?        @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  enrollmentStep EnrollmentStep?

  @@index([clientId])
  @@index([dealId])
  @@index([projectId])
  @@index([parentId])
  @@index([assigneeId, status])
  @@index([dueDate])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// Reusable job templates, e.g. "Monthly Bookkeeping" → tasks + subtasks.
model ProjectTemplate {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  createdAt   DateTime       @default(now())
  tasks       TemplateTask[]
  projects    Project[]
  services    Service[]
}

model TemplateTask {
  id              String          @id @default(cuid())
  templateId      String
  template        ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parentId        String?
  parent          TemplateTask?   @relation("TemplateSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks        TemplateTask[]  @relation("TemplateSubtasks")
  title           String
  description     String?
  // Due date = project start + this many days.
  dueOffsetDays   Int?
  estimateMinutes Int?
  priority        Priority        @default(MEDIUM)
  position        Float           @default(0)
  resourceId      String?
  resource        Resource?       @relation(fields: [resourceId], references: [id], onDelete: SetNull)
}

enum DealStage {
  NEW_LEAD
  DISCOVERY_BOOKED
  DISCOVERY_COMPLETED
  PROPOSAL_REQUIRED
  PROPOSAL_SENT
  WON
  LOST
}

enum LeadSource {
  WEBSITE_FORM
  BOOKING_PAGE
  REFERRAL
  MANUAL
  OTHER
}

model Deal {
  id                String      @id @default(cuid())
  // Prospective client: a company or an individual.
  name              String
  contactName       String
  email             String?
  phone             String?
  entityType        EntityType?
  servicesInterest  String?
  notes             String?
  source            LeadSource  @default(MANUAL)
  stage             DealStage   @default(NEW_LEAD)
  stageChangedAt    DateTime    @default(now())
  valueCents        Int         @default(0)
  // Win likelihood in %, defaults per stage when null.
  probability       Int?
  expectedCloseDate DateTime?   @db.Date
  lostReason        String?
  ownerId           String?
  owner             User?       @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  clientId          String?
  client            Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  popiaConsentAt    DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  activities DealActivity[]
  tasks      Task[]
  bookings   Booking[]
  emails     EmailMessage[]
  proposals  Proposal[]

  @@index([stage])
  @@index([email])
}

enum ActivityType {
  NOTE
  STAGE_CHANGE
  EMAIL
  BOOKING
  TASK
  SYSTEM
}

model DealActivity {
  id        String       @id @default(cuid())
  dealId    String
  deal      Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type      ActivityType
  body      String
  actorId   String?
  createdAt DateTime     @default(now())

  @@index([dealId, createdAt])
}

model BookingLink {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  description     String?
  durationMinutes Int       @default(30)
  bufferMinutes   Int       @default(15)
  minNoticeHours  Int       @default(12)
  maxDaysAhead    Int       @default(21)
  // ISO weekdays (1=Mon … 7=Sun) and working hours in firm time, "HH:MM".
  days            Int[]     @default([1, 2, 3, 4, 5])
  startTime       String    @default("09:00")
  endTime         String    @default("16:30")
  // Used for the automatic email to new leads.
  isDefault       Boolean   @default(false)
  active          Boolean   @default(true)
  hostId          String
  host            User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bookings        Booking[]
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id            String        @id @default(cuid())
  bookingLinkId String
  bookingLink   BookingLink   @relation(fields: [bookingLinkId], references: [id], onDelete: Cascade)
  hostId        String
  host          User          @relation(fields: [hostId], references: [id], onDelete: Cascade)
  dealId        String?
  deal          Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  startsAt      DateTime
  endsAt        DateTime
  status        BookingStatus @default(CONFIRMED)
  name          String
  email         String
  phone         String?
  company       String?
  message       String?
  googleEventId String?
  meetUrl       String?
  // Secret for the lead's reschedule/cancel link.
  manageToken   String        @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([hostId, startsAt])
}

// A staff member's Google Calendar + Gmail authorisation (separate from sign-in).
model GoogleConnection {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail           String
  // AES-256-GCM encrypted with a key derived from AUTH_SECRET.
  refreshTokenEncrypted String
  scopes                String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum EmailStatus {
  QUEUED
  SENT
  SKIPPED
  FAILED
}

// Outbox: every automated email is recorded here, then sent by the worker.
model EmailMessage {
  id        String      @id @default(cuid())
  to        String
  subject   String
  html      String
  text      String
  senderId  String?
  dealId    String?
  deal      Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)
  status    EmailStatus @default(QUEUED)
  error     String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([status])
}

// Minimal Postgres-backed job queue (claimed with FOR UPDATE SKIP LOCKED).
model Job {
  id        String    @id @default(cuid())
  name      String
  payload   Json
  runAt     DateTime  @default(now())
  attempts  Int       @default(0)
  lockedAt  DateTime?
  doneAt    DateTime?
  lastError String?
  createdAt DateTime  @default(now())

  @@index([doneAt, runAt])
}

// On/off switches and numbers for each automation rule.
model AutomationSetting {
  key       String   @id
  enabled   Boolean  @default(true)
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// One row: firm details shown on proposals, VAT and proposal defaults.
model FirmSettings {
  id                   String   @id @default("firm")
  legalName            String   @default("Outset")
  registrationNumber   String?
  vatNumber            String?
  vatRegistered        Boolean  @default(true)
  vatRatePercent       Int      @default(15)
  email                String?
  phone                String?
  address              String?
  proposalValidityDays Int      @default(14)
  proposalTerms        String?
  welcomeMessage       String?
  updatedAt            DateTime @updatedAt
}

enum BillingType {
  ONCE_OFF
  MONTHLY
}

model Service {
  id          String           @id @default(cuid())
  name        String
  description String?
  billingType BillingType      @default(MONTHLY)
  // Price excluding VAT, in cents.
  priceCents  Int
  taxable     Boolean          @default(true)
  // Job template used to set up the project when a client signs up.
  templateId  String?
  template    ProjectTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  active      Boolean          @default(true)
  position    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  packageItems ServicePackageItem[]
  lineItems    ProposalLineItem[]
}

model ServicePackage {
  id          String               @id @default(cuid())
  name        String
  description String?
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  items       ServicePackageItem[]
}

model ServicePackageItem {
  id         String         @id @default(cuid())
  packageId  String
  package    ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  quantity   Int            @default(1)
  // Optional package price per unit (excl. VAT); falls back to the service price.
  priceCents Int?
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum SignatureMethod {
  CLICK_TO_ACCEPT
  UPLOADED_PDF
  DOCUSIGN
}

model Proposal {
  id              String           @id @default(cuid())
  number          Int              @unique @default(autoincrement())
  title           String
  dealId          String
  deal            Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status          ProposalStatus   @default(DRAFT)
  introduction    String?
  terms           String?
  validUntil      DateTime         @db.Date
  // When retainers start; the first month is part of the first payment.
  startDate       DateTime?        @db.Date
  vatRatePercent  Int
  // Totals in cents, recalculated whenever line items change.
  onceOffExVat    Int              @default(0)
  monthlyExVat    Int              @default(0)
  onceOffVat      Int              @default(0)
  monthlyVat      Int              @default(0)
  // Secret for the client-facing link.
  publicToken     String           @unique
  createdById     String?
  sentAt          DateTime?
  viewedAt        DateTime?
  signedAt        DateTime?
  signatureMethod SignatureMethod?
  signedName      String?
  signedIp        String?
  signedUserAgent String?
  // SHA-256 of the proposal content the client accepted.
  signedHash      String?
  signedFileId    String?
  signedFile      StoredFile?      @relation(fields: [signedFileId], references: [id], onDelete: SetNull)
  paidAt          DateTime?
  acceptedAt      DateTime?
  declinedReason  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  lineItems     ProposalLineItem[]
  payments      Payment[]
  subscriptions Subscription[]

  @@index([status])
  @@index([dealId])
}

model ProposalLineItem {
  id             String      @id @default(cuid())
  proposalId     String
  proposal       Proposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  billingType    BillingType
  quantity       Int         @default(1)
  unitPriceCents Int
  taxable        Boolean     @default(true)
  position       Int         @default(0)
}

enum PaymentProvider {
  PAYSTACK
  SIMULATED
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id           String          @id @default(cuid())
  proposalId   String
  proposal     Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  provider     PaymentProvider
  reference    String          @unique
  amountCents  Int
  currency     String          @default("ZAR")
  status       PaymentStatus   @default(PENDING)
  channel      String?
  customerCode String?
  note         String?
  paidAt       DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id               String             @id @default(cuid())
  proposalId       String
  proposal         Proposal           @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  clientId         String?
  client           Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  provider         PaymentProvider
  amountCents      Int
  planCode         String?
  subscriptionCode String?            @unique
  status           SubscriptionStatus @default(PENDING)
  nextPaymentDate  DateTime?          @db.Date
  lastError        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// Small files kept in Postgres (signed proposals). Larger client documents
// will use object storage in Phase 4.
enum FilePurpose {
  SIGNED_PROPOSAL
  CLIENT_DOCUMENT
  TASK_ATTACHMENT
  RESOURCE_ATTACHMENT
}

model StoredFile {
  id               String          @id @default(cuid())
  name             String
  contentType      String
  size             Int
  data             Bytes
  purpose          FilePurpose     @default(SIGNED_PROPOSAL)
  uploadedById     String?
  // Set when the client uploaded it through their onboarding link.
  uploadedByClient Boolean         @default(false)
  createdAt        DateTime        @default(now())
  proposals        Proposal[]
  onboardingItem   OnboardingFile?
  taskAttachment   TaskAttachment?
  resourceId       String?
  resource         Resource?       @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model TaskAttachment {
  id        String     @id @default(cuid())
  taskId    String
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileId    String     @unique
  file      StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([taskId])
}

enum OnboardingStage {
  INFO_REQUESTED
  INFO_RECEIVED
  SETUP
  REVIEW
  COMPLETE
}

model Onboarding {
  id             String          @id @default(cuid())
  clientId       String
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  stage          OnboardingStage @default(INFO_REQUESTED)
  stageChangedAt DateTime        @default(now())
  ownerId        String?
  reviewerId     String?
  proposalId     String?
  // Secret for the client's upload page.
  uploadToken    String          @unique
  remindersSent  Int             @default(0)
  lastReminderAt DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items      OnboardingItem[]
  activities OnboardingActivity[]

  @@index([stage])
}

enum OnboardingItemKind {
  INFO
  SETUP
}

enum OnboardingItemStatus {
  PENDING
  RECEIVED
  ACCEPTED
  REJECTED
  NOT_APPLICABLE
  DONE
}

model OnboardingItem {
  id            String               @id @default(cuid())
  onboardingId  String
  onboarding    Onboarding           @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  kind          OnboardingItemKind
  label         String
  description   String?
  required      Boolean              @default(true)
  // INFO items: client can upload files and/or type an answer.
  allowsText    Boolean              @default(false)
  status        OnboardingItemStatus @default(PENDING)
  clientAnswer  String?
  // Shown to the client when an item is sent back.
  staffNote     String?
  completedById String?
  completedAt   DateTime?
  position      Int                  @default(0)
  files         OnboardingFile[]

  @@index([onboardingId, kind])
}

model OnboardingFile {
  id        String         @id @default(cuid())
  itemId    String
  item      OnboardingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fileId    String         @unique
  file      StoredFile     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
}

model OnboardingActivity {
  id           String     @id @default(cuid())
  onboardingId String
  onboarding   Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  body         String
  actorId      String?
  byClient     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([onboardingId, createdAt])
}

enum ResourceType {
  SOP
  TEMPLATE
  GUIDE
  POLICY
}

enum ResourceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Resource Hub: SOPs, templates, guides and policies (Markdown body).
model Resource {
  id               String         @id @default(cuid())
  title            String
  summary          String?
  body             String
  type             ResourceType   @default(SOP)
  category         String
  tags             String[]       @default([])
  videoUrl         String?
  status           ResourceStatus @default(DRAFT)
  version          Int            @default(1)
  ownerId          String?
  owner            User?          @relation("ResourceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  updatedById      String?
  reviewDue        DateTime?      @db.Date
  reviewNotifiedAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  versions       ResourceVersion[]
  reads          ResourceRead[]
  files          StoredFile[]
  tasks          Task[]
  templateTasks  TemplateTask[]
  programmeSteps ProgrammeStep[]

  @@index([status, category])
}

model ResourceVersion {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  version    Int
  title      String
  body       String
  changeNote String?
  editedById String?
  createdAt  DateTime @default(now())

  @@unique([resourceId, version])
}

// "I've read this" per user per version.
model ResourceRead {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    Int
  readAt     DateTime @default(now())

  @@unique([resourceId, userId, version])
}

// Staff onboarding programmes, e.g. "New team member: first 30 days".
model Programme {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  steps       ProgrammeStep[]
  enrollments Enrollment[]
}

model ProgrammeStep {
  id              String           @id @default(cuid())
  programmeId     String
  programme       Programme        @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  // Read-and-acknowledge steps point at a Resource Hub item.
  resourceId      String?
  resource        Resource?        @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  dueOffsetDays   Int              @default(0)
  estimateMinutes Int?
  position        Int              @default(0)
  enrollmentSteps EnrollmentStep[]
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Enrollment {
  id          String           @id @default(cuid())
  programmeId String
  programme   Programme        @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation("Enrollee", fields: [userId], references: [id], onDelete: Cascade)
  mentorId    String?
  mentor      User?            @relation("Mentor", fields: [mentorId], references: [id], onDelete: SetNull)
  startDate   DateTime         @db.Date
  status      EnrollmentStatus @default(ACTIVE)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  steps       EnrollmentStep[]

  @@index([userId, status])
}

model EnrollmentStep {
  id           String         @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String?
  step         ProgrammeStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  title        String
  resourceId   String?
  // Each step is also a task for the employee.
  taskId       String?        @unique
  task         Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  completedAt  DateTime?
  position     Int            @default(0)
}
